{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unicom360.com/conformance/schema/responses.schema.json",
  "title": "responses.json: canned responses and the result or error each must produce",
  "type": "object",
  "required": ["version", "description", "vectors"],
  "additionalProperties": false,
  "properties": {
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "description": { "type": "string" },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "operation", "http", "expect"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "description": { "type": "string" },
          "operation": { "$ref": "common.schema.json#/$defs/operation" },
          "off_spec": {
            "description": "True when the body deliberately does not match openapi.yaml (robustness cases).",
            "type": "boolean"
          },
          "now_unix": { "$ref": "common.schema.json#/$defs/unix_time" },
          "http": { "$ref": "common.schema.json#/$defs/http" },
          "expect": {
            "oneOf": [
              {
                "type": "object",
                "required": ["result"],
                "additionalProperties": false,
                "properties": {
                  "result": { "type": "object" },
                  "helpers": { "$ref": "#/$defs/helpers" }
                }
              },
              {
                "type": "object",
                "required": ["error"],
                "additionalProperties": false,
                "properties": {
                  "error": {
                    "type": "object",
                    "required": ["type", "class", "code", "message", "api_reference", "http_status", "data_present"],
                    "additionalProperties": false,
                    "properties": {
                      "type": { "$ref": "common.schema.json#/$defs/error_type" },
                      "class": { "$ref": "common.schema.json#/$defs/error_class" },
                      "code": { "$ref": "common.schema.json#/$defs/code" },
                      "message": {
                        "description": "The exact message, or null when it is SDK-generated text (any non-empty string passes).",
                        "type": ["string", "null"]
                      },
                      "api_reference": { "type": ["string", "null"] },
                      "http_status": { "type": "integer" },
                      "data_present": { "type": "boolean" },
                      "retry_after": { "type": "number", "exclusiveMinimum": 0 }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "helpers": {
      "description": "Positions (0-based indexes into the result's results array) the result helpers must return.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted": { "$ref": "#/$defs/positions" },
        "invalid": { "$ref": "#/$defs/positions" },
        "rejected": { "$ref": "#/$defs/positions" },
        "by_number": { "$ref": "#/$defs/lookups" },
        "by_address": { "$ref": "#/$defs/lookups" }
      }
    },
    "positions": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true },
    "lookups": {
      "type": "object",
      "additionalProperties": { "type": ["integer", "null"], "minimum": 0 }
    }
  }
}
