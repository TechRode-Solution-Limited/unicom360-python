{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unicom360.com/conformance/schema/signatures.schema.json",
  "title": "webhooks/signatures.json: webhook signature verification vectors",
  "type": "object",
  "required": [
    "version",
    "description",
    "algorithm",
    "vectors"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "description": {
      "type": "string"
    },
    "algorithm": {
      "type": "string"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "secret",
          "headers",
          "body_base64",
          "body_text",
          "now_unix",
          "tolerance",
          "expect"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "description": {
            "type": "string"
          },
          "secret": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "headers": {
            "$ref": "common.schema.json#/$defs/headers"
          },
          "body_base64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          },
          "body_text": {
            "type": "string"
          },
          "now_unix": {
            "type": "integer",
            "minimum": 0
          },
          "tolerance": {
            "type": "integer",
            "minimum": 0
          },
          "expect": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "valid"
                ],
                "additionalProperties": false,
                "properties": {
                  "valid": {
                    "const": true
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "valid",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "valid": {
                    "const": false
                  },
                  "reason": {
                    "enum": [
                      "missing_signature",
                      "missing_timestamp",
                      "invalid_timestamp",
                      "malformed_signature",
                      "timestamp_out_of_tolerance",
                      "signature_mismatch"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
