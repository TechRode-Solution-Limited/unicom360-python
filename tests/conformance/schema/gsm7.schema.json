{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unicom360.com/conformance/schema/gsm7.schema.json",
  "title": "gsm7.json: GSM-7 checks, character counts and billing units",
  "type": "object",
  "required": ["version", "description", "charset", "max_length", "unit_length", "vectors"],
  "additionalProperties": false,
  "properties": {
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "description": { "type": "string" },
    "charset": { "type": "string", "description": "Every character the gateway accepts, in sms_part_counter 0.1.7's order." },
    "max_length": { "const": 1200 },
    "unit_length": { "const": 160 },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "is_gsm7", "length", "units", "non_gsm", "validate"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "description": { "type": "string" },
          "text": { "type": "string" },
          "is_gsm7": { "type": "boolean" },
          "length": { "type": "integer", "minimum": 0 },
          "units": { "type": "integer", "minimum": 1 },
          "non_gsm": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["char", "index"],
              "additionalProperties": false,
              "properties": {
                "char": { "type": "string", "minLength": 1 },
                "index": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "validate": {
            "type": "array",
            "items": { "enum": ["empty", "too_long", "non_gsm"] },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
